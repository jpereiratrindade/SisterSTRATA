	cd /run/media/jpereiratrindade/labeco10T/dev/cpp/SisterSTRATA && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
